# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# NextAuth
NEXTAUTH_SECRET=generate-a-random-string-here
NEXTAUTH_URL=https://coliving-cait.vercel.app

# Email (magic links) — Resend (free tier: 3000 emails/month)
# Sign up at resend.com, verify your domain, get an API key
EMAIL_SERVER=smtp://resend:re_YOUR_API_KEY@smtp.resend.com:465
EMAIL_FROM=Coliving Cait <hello@colivingcait.com>

# Public site origin — drives canonicals, sitemap, and structured data.
# Change this (not the code) when the domain changes.
NEXT_PUBLIC_SITE_URL=https://colivingcait.com

# Rent ledger tool (/tools/rent-ledger)
# Salt for hashing PadSplit PSIDs before benchmark snapshots are stored.
# Any long random string; changing it breaks dedupe of existing snapshots.
RENT_LEDGER_HASH_SALT=generate-a-random-string-here
# CRM webhook for rent-ledger leads. Defaults to the CRM's site-form webhook.
# CRM_WEBHOOK_URL=https://crm.callcaitlyn.com/api/webhooks/site-form
# When set, requests carry X-Signature: HMAC-SHA256 of the body (hex).
# CRM_WEBHOOK_SECRET=
# Who can open /tools/rent-ledger/admin (comma-separated). Defaults to
# colivingcait@gmail.com and cv.sellshomes@gmail.com.
# RENT_LEDGER_ADMIN_EMAILS=
